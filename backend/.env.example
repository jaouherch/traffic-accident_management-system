# Copy to .env and replace the placeholders. Never commit .env.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///data.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: leave empty to disable public admin self-registration.
ADMIN_INVITE_CODE=

# Optional: approval notifications. Do not reuse an exposed app password.
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# Local Flask runner only. Docker uses gunicorn.
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
